"""
from __future__ import annotations

from agent_tau2.component_runtime.types import (
    Component,
    ComponentClass,
    ComponentContext,
    Decision,
    Trust,
)


# ---- predicate --------------------------------------------------------------


def _matches(ctx: ComponentContext) -> bool:
    """Return True iff this hook should fire on `ctx`.

    Read ctx.tool_name / ctx.tool_args (per-tool events) / ctx.assistant_message
    (post_llm_response) / ctx.incoming_message (post_tool_use; user_prompt_submit)
    / ctx.history / ctx.domain_policy / ctx.tool_names. ctx.event names the
    firing event for branchable handlers. Do NOT read ctx.task_id (hidden).
    """
    # TODO: write the predicate. Keep it cheap and side-effect-free.
    return False


# ---- handler ----------------------------------------------------------------


def _handler(ctx: ComponentContext) -> Decision:
    """Return the Decision when the matcher returned True.

    Permitted decisions are determined by (cls, listens). See SKILL.md matrix.
    """
    # TODO: build and return the Decision.
    return Decision.allow()


# ---- component declaration --------------------------------------------------


COMPONENT = Component(
    name="<stable_component_id>",
    cls=ComponentClass.MECHANISM_LAYER,         # or REACTIVE_GUARD / INDUCED_RULE
    listens="pre_tool_use",                     # see Lifecycle events table in SKILL.md
    matcher=_matches,
    handler=_handler,
    priority=100,                               # smaller fires first within an event bucket
    emits=(),                                   # self-doc of custom Tier-2/3 events
    trust=Trust(
        evidence_anchor=(
            "<one or two sentences naming the stable structure this hook "
            "anchors on. A system field, a tool schema field, a protocol "
            "invariant, or a general algorithm. NOT a policy reading.>"
        ),
        blast_radius="local",                   # local | workflow | global
        rollback_when=(
            "<observable condition under which this hook is dead weight or "
            "actively harmful; e.g., 'matcher fires zero times across 30 "
            "consecutive task runs in .component-state/<tag>/fired.jsonl'.>"
        ),
        out_of_evidence_probe=(
            "<one concrete case NOT in your evidence sims where the matcher "
            "would fire. State what the handler returns and why that is "
            "correct even without a sim showing it. REQUIRED for INDUCED_RULE.>"
        ),
        fallback=(
            "<what happens when the matcher returns False or the handler "
            "returns allow. Typically: the LLM's original output passes "
            "through unchanged.>"
        ),
    ),
)
