from __future__ import annotations

from agent.component_runtime.types import (
    Component,
    ComponentClass,
    ComponentContext,
    Decision,
    Trust,
)


def _matches(ctx: ComponentContext) -> bool:
    """Return True iff this component should fire on `ctx`.

    Read ctx.extras / ctx.prompt / ctx.raw_response / ctx.answer /
    ctx.shared / ctx.current_tool_* (per-tool events) / ctx.current_iter.
    Do NOT read ctx.task_id (treat as opaque).
    """
    # TODO: implement the predicate. Keep it cheap and side-effect-free.
    return False


def _handler(ctx: ComponentContext) -> Decision:
    """Return the Decision when the matcher returned True.

    Permitted decisions are determined by (cls, listens). See SKILL.md matrix.
    """
    # TODO: build and return the Decision.
    return Decision.allow()


COMPONENT = Component(
    name="<stable_component_id>",
    cls=ComponentClass.MECHANISM_LAYER,         # or REACTIVE_GUARD / INDUCED_RULE
    listens="pre_prompt_build",                 # event name; see SKILL.md events table
    matcher=_matches,
    handler=_handler,
    priority=100,
    emits=(),                                   # declare custom events you raise
    trust=Trust(
        evidence_anchor=(
            "<one or two sentences naming the stable structure this component "
            "anchors on — a system field, LLM API field, tool schema, or "
            "general algorithm. NOT a policy reading.>"
        ),
        blast_radius="local",                   # local | workflow | global
        rollback_when=(
            "<observable condition under which this component is dead weight "
            "or actively harmful.>"
        ),
        out_of_evidence_probe=(
            "<one concrete case NOT in your evidence traces where the matcher "
            "would fire. State what the handler returns and why that is "
            "correct even without a trace showing it. REQUIRED for INDUCED_RULE.>"
        ),
        fallback=(
            "<what happens when the matcher returns False or the handler "
            "returns allow. Typically: the default GAIA flow runs unchanged.>"
        ),
    ),
)
